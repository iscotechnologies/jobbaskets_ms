{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/social-poster/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/social-poster/tsconfig.app.json"
  },
  "monorepo": true,
  "defaultProject": "social-poster",
  "root": "apps/social-poster",
  "projects": {
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "social-poster": {
      "type": "application",
      "root": "apps/social-poster",
      "entryFile": "main",
      "sourceRoot": "apps/social-poster/src",
      "compilerOptions": {
        "tsConfigPath": "apps/social-poster/tsconfig.app.json",
        "assets": [
          {
            "include": "assets/**/*",
            "watchAssets": true
          }
        ]
      }
    }
  }
}