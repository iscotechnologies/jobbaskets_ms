# ============================================================================
# JobBaskets Social Poster Microservice Environment Configuration
# ============================================================================

# Service Configuration
PORT=3001
SOCIAL_POSTER_PORT=3001

# Internal Service-to-Service Secret Key (Required by Laravel API)
INTERNAL_SERVICE_SECRET=your_internal_service_secret_key_here

# Platform URL (Used for job URLs: {PLATFORM_FRONTEND_URL}/jobs/{uuid} and banner watermarks)
PLATFORM_FRONTEND_URL=https://jobbaskets.com

# Redis Configuration (Shared with Laravel or Standalone)
# For local dev: 127.0.0.1
# For Docker internal network on JB test server: jobbaskets_api_redis_test
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=jb:social:

# Queue Configuration
SOCIAL_POST_QUEUE_NAME=social_post_queue
QUEUE_CONCURRENCY=5
QUEUE_RATE_LIMIT_MAX=10
QUEUE_RATE_LIMIT_DURATION_MS=60000

# Telegram Channel Plugin
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@jobbaskets

# Facebook Page Plugin
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Instagram Business Plugin
INSTAGRAM_ACCOUNT_ID=

# LinkedIn Plugin Credentials
LINKEDIN_ORG_ID=
LINKEDIN_ACCESS_TOKEN=
